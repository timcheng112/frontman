---
import { withBase } from "../utils/paths";

const homeHref = withBase("/");
const logoSrc = withBase("/images/frontman-logo.png");
---

<header class="header">
  <a class="brand" href={homeHref}>
    <img
      class="brand-avatar"
      src={logoSrc}
      alt="Frontman logo"
      width="48"
      height="48"
    />
    <div class="brand-lockup">
      <p class="brand-mark">Frontman</p>
      <p class="brand-copy">Frontend + AI Weekly Digest</p>
    </div>
  </a>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0 1.4rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 0.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
  }

  .brand-avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 10px 24px rgba(30, 41, 59, 0.08);
  }

  .brand-lockup {
    display: grid;
    gap: 0.1rem;
  }

  .brand-mark {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 700;
    color: var(--text-primary);
  }

  .brand-copy {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.78rem;
    letter-spacing: 0.01em;
  }
</style>
