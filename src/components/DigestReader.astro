---
import type { CollectionEntry } from "astro:content";
import { formatDigestDate } from "../utils/digests";

interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

interface PageDescriptor {
  kind: "opening" | "story" | "pro-tip" | "closing" | "section";
  badge: string;
  title: string;
}

interface Props {
  digest: CollectionEntry<"digests">;
  headings: MarkdownHeading[];
}

const { digest, headings } = Astro.props;
const pageDescriptors = buildPageDescriptors(headings);
const readerId = `digest-reader-${digest.id}`;

function buildPageDescriptors(allHeadings: MarkdownHeading[]): PageDescriptor[] {
  const sectionHeadings = allHeadings.filter((heading) => heading.depth === 2);

  return sectionHeadings.map((heading, index) => classifyPage(heading.text, index, sectionHeadings.length));
}

function classifyPage(text: string, index: number, total: number): PageDescriptor {
  const normalized = text.trim();
  const lower = normalized.toLowerCase();

  if (index === 0 || lower === "opening") {
    return {
      kind: "opening",
      badge: "Opening",
      title: "Frontman's kickoff"
    };
  }

  if (index === total - 1 || lower === "closing notes") {
    return {
      kind: "closing",
      badge: "Closing",
      title: "Final thoughts"
    };
  }

  if (lower.startsWith("pro tip:")) {
    return {
      kind: "pro-tip",
      badge: "Pro Tip",
      title: normalized.slice("Pro Tip:".length).trim() || "Level-up move"
    };
  }

  if (lower.startsWith("news:") || lower.startsWith("story:")) {
    const prefixLength = lower.startsWith("news:") ? "News:".length : "Story:".length;
    return {
      kind: "story",
      badge: `News ${index}`,
      title: normalized.slice(prefixLength).trim() || `News ${index}`
    };
  }

  return {
    kind: "section",
    badge: `Page ${index + 1}`,
    title: normalized
  };
}
---

<article class="reader-shell" data-digest-reader id={readerId}>
  <div class="reader-layout">
    <aside class="reader-sidebar">
      <p class="reader-sidebar-label">Issue map</p>
      <ol class="reader-index" data-reader-index>
        {
          pageDescriptors.map((page, index) => (
            <li>
              <button type="button" class="reader-index-button" data-page-target={index}>
                <span class="reader-index-step">{String(index + 1).padStart(2, "0")}</span>
                <span class="reader-index-copy">
                  <span class="reader-index-kind">{page.badge}</span>
                  <span class="reader-index-title">{page.title}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ol>
    </aside>

    <div class="reader-stage">
      <div class="reader-toolbar">
        <div class="reader-progress">
          <p class="reader-progress-kicker" data-reader-progress-kicker>Opening</p>
          <p class="reader-progress-title" data-reader-progress-title>{pageDescriptors[0]?.title ?? digest.data.title}</p>
        </div>

        <div class="reader-controls">
          <button type="button" class="reader-nav-button" data-reader-prev>
            ← Prev
          </button>
          <p class="reader-page-count" data-reader-page-count>
            1 / {Math.max(pageDescriptors.length, 1)}
          </p>
          <button type="button" class="reader-nav-button" data-reader-next>
            Next →
          </button>
        </div>
      </div>

      <div class="reader-page-stack" data-reader-page-stack>
        <section class="reader-page reader-page--cover" data-reader-cover>
          <div class="reader-cover-hero">
            {digest.data.tags.length > 0 && (
              <div class="tag-row">
                {digest.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}

            <p class="reader-cover-label">Frontman Weekly Digest</p>
            <h1>{digest.data.title}</h1>

            <div class="meta-row">
              <span>{formatDigestDate(digest.data.pubDate, "long")}</span>
              {digest.data.readTime && <span>· {digest.data.readTime} read</span>}
            </div>

            <p class="summary">{digest.data.description}</p>
          </div>

          <div class="reader-opening-panel reader-page-body prose article-prose" data-reader-panel>
            <p class="reader-opening-kicker" data-reader-panel-kicker>Opening</p>
          </div>
        </section>
      </div>

      <div class="prose article-prose reader-source-content" data-reader-source-content>
        <slot />
      </div>
    </div>
  </div>

  <script type="application/json" data-reader-config set:html={JSON.stringify(pageDescriptors)} />
</article>

<script is:inline data-reader-root={readerId}>
  (() => {
    const script = document.currentScript;
    const rootId = script?.dataset.readerRoot;
    const root =
      (rootId ? document.getElementById(rootId) : null) ??
      (script?.previousElementSibling instanceof HTMLElement &&
      script.previousElementSibling.matches("[data-digest-reader]")
        ? script.previousElementSibling
        : null);
    if (!root) return;

    const source = root.querySelector("[data-reader-source-content]");
    const panel = root.querySelector("[data-reader-panel]");
    const panelKicker = root.querySelector("[data-reader-panel-kicker]");
    const toolbar = root.querySelector(".reader-toolbar");
    const indexButtons = Array.from(root.querySelectorAll("[data-page-target]"));
    const prevButton = root.querySelector("[data-reader-prev]");
    const nextButton = root.querySelector("[data-reader-next]");
    const progressKicker = root.querySelector("[data-reader-progress-kicker]");
    const progressTitle = root.querySelector("[data-reader-progress-title]");
    const pageCount = root.querySelector("[data-reader-page-count]");
    const configScript = root.querySelector("[data-reader-config]");

    if (
      !source ||
      !panel ||
      !panelKicker ||
      !toolbar ||
      !prevButton ||
      !nextButton ||
      !progressKicker ||
      !progressTitle ||
      !pageCount ||
      !configScript
    ) {
      return;
    }

    let pageDescriptors = [];
    try {
      pageDescriptors = JSON.parse(configScript.textContent || "[]");
    } catch {
      return;
    }

    const childNodes = Array.from(source.childNodes);
    const groups = [];
    let currentGroup = [];

    for (const node of childNodes) {
      const isHeading = node.nodeType === Node.ELEMENT_NODE && node.tagName === "H2";
      const isMeaningfulText = node.nodeType === Node.TEXT_NODE && node.textContent?.trim();

      if (isHeading) {
        if (currentGroup.length > 0) {
          groups.push(currentGroup);
        }
        currentGroup = [node];
        continue;
      }

      if (currentGroup.length > 0) {
        currentGroup.push(node);
        continue;
      }

      if (isMeaningfulText) {
        currentGroup.push(node);
      }
    }

    if (currentGroup.length > 0) {
      groups.push(currentGroup);
    }

    if (groups.length === 0 || groups.length !== pageDescriptors.length) {
      return;
    }

    source.hidden = true;
    root.dataset.readerReady = "true";

    let activeIndex = 0;
    const panelContentNodes = [];

    const renderPanelBody = () => {
      while (panel.childNodes.length > 0) {
        panel.removeChild(panel.firstChild);
      }

      const descriptor = pageDescriptors[activeIndex];
      panelKicker.textContent = descriptor?.badge ?? "Page";
      panel.appendChild(panelKicker);

      const group = groups[activeIndex] ?? [];
      const nodes =
        activeIndex === 0 &&
        group[0]?.nodeType === Node.ELEMENT_NODE &&
        group[0].tagName === "H2"
          ? group.slice(1)
          : group;

      nodes.forEach((node) => {
        panel.appendChild(node);
        panelContentNodes.push(node);
      });
    };

    const render = () => {
      indexButtons.forEach((button, index) => {
        button.classList.toggle("is-active", index === activeIndex);
      });

      const descriptor = pageDescriptors[activeIndex];
      progressKicker.textContent = descriptor?.badge ?? "Page";
      progressTitle.textContent = descriptor?.title ?? "";
      pageCount.textContent = `${activeIndex + 1} / ${pageDescriptors.length}`;
      prevButton.toggleAttribute("disabled", activeIndex === 0);
      nextButton.toggleAttribute("disabled", activeIndex === pageDescriptors.length - 1);
      renderPanelBody();
    };

    const scrollReaderIntoView = () => {
      const stickyOffset = toolbar.getBoundingClientRect().height + 24;
      const top = panel.getBoundingClientRect().top + window.scrollY - stickyOffset;
      window.scrollTo({
        top: Math.max(0, top),
        behavior: "smooth"
      });
    };

    indexButtons.forEach((button, index) => {
      button.addEventListener("click", () => {
        activeIndex = index;
        render();
        scrollReaderIntoView();
      });
    });

    prevButton.addEventListener("click", () => {
      if (activeIndex === 0) return;
      activeIndex -= 1;
      render();
      scrollReaderIntoView();
    });

    nextButton.addEventListener("click", () => {
      if (activeIndex === pageDescriptors.length - 1) return;
      activeIndex += 1;
      render();
      scrollReaderIntoView();
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft" && activeIndex > 0) {
        activeIndex -= 1;
        render();
        scrollReaderIntoView();
      }

      if (event.key === "ArrowRight" && activeIndex < pageDescriptors.length - 1) {
        activeIndex += 1;
        render();
        scrollReaderIntoView();
      }
    });

    render();
  })();
</script>

<style>
  .reader-shell {
    max-width: 70rem;
    margin: 0 auto;
  }

  .reader-layout {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .reader-sidebar {
    position: sticky;
    top: 6rem;
    padding: 1rem;
    border-radius: 1.25rem;
    border: 1px solid var(--border-subtle);
    background: rgba(255, 252, 245, 0.9);
    backdrop-filter: blur(10px);
  }

  .reader-sidebar-label {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .reader-index {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reader-index-button {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    padding: 0.85rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 1rem;
    background: transparent;
    text-align: left;
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease,
      color 180ms ease;
  }

  .reader-index-button:hover,
  .reader-index-button.is-active {
    background: rgba(255, 255, 255, 0.88);
    border-color: rgba(37, 99, 235, 0.25);
    color: var(--text-primary);
    transform: translateX(2px);
  }

  .reader-index-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--surface-soft);
    color: var(--accent-primary);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .reader-index-copy {
    display: grid;
    gap: 0.2rem;
  }

  .reader-index-kind {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .reader-index-title {
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .reader-stage {
    display: grid;
    gap: 1rem;
  }

  .reader-toolbar {
    position: sticky;
    top: 5.25rem;
    z-index: 6;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    padding: 1rem 1.2rem;
    border-radius: 1.25rem;
    border: 1px solid var(--border-subtle);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 251, 244, 0.98));
    box-shadow: 0 18px 36px rgba(30, 41, 59, 0.06);
  }

  .reader-progress {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .reader-progress-kicker {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .reader-progress-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .reader-controls {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    justify-self: end;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .reader-nav-button {
    min-height: 2.8rem;
    padding: 0.72rem 1rem;
    border-radius: 0.95rem;
    border: 1px solid var(--border-subtle);
    background: var(--surface);
    color: var(--accent-primary);
    font-weight: 700;
    cursor: pointer;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      opacity 180ms ease;
  }

  .reader-nav-button:hover:not(:disabled) {
    transform: translateY(-1px);
    border-color: rgba(37, 99, 235, 0.32);
    box-shadow: 0 12px 22px rgba(37, 99, 235, 0.1);
  }

  .reader-nav-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .reader-page-count {
    margin: 0;
    color: var(--text-muted);
    font-weight: 600;
  }

  .reader-page {
    min-height: 68vh;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: 1.5rem;
    border: 1px solid var(--border-subtle);
    background:
      radial-gradient(circle at top right, rgba(125, 211, 252, 0.18), transparent 28%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.99), rgba(255, 251, 244, 0.98));
    box-shadow: 0 24px 48px rgba(30, 41, 59, 0.08);
  }

  .reader-page--cover {
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  .reader-cover-hero {
    display: grid;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .reader-cover-label,
  .reader-opening-kicker,
  .reader-page-badge {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.72rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    background: var(--soft-blue);
    color: var(--accent-primary);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
    max-width: 12ch;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .summary {
    margin: 0;
    max-width: 42rem;
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 1.06rem;
  }

  .reader-opening-panel {
    display: grid;
    gap: 0.9rem;
  }

  .reader-page-body {
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border-radius: 1.1rem;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(234, 220, 198, 0.9);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .reader-page-body :global(h2) {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    max-width: 100%;
  }

  .reader-page-body :global(p),
  .reader-page-body :global(li) {
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .reader-page-body :global(ul),
  .reader-page-body :global(ol) {
    padding-left: 1.2rem;
  }

  .reader-page-body :global(strong) {
    color: var(--text-primary);
  }

  .reader-source-content {
    margin-top: 0;
  }

  [data-reader-ready="true"] .reader-source-content {
    display: none;
  }

  @media (max-width: 980px) {
    .reader-layout {
      grid-template-columns: 1fr;
    }

    .reader-sidebar {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .reader-toolbar {
      top: 5rem;
      grid-template-columns: 1fr;
      padding: 0.95rem 1rem;
    }

    .reader-controls {
      width: 100%;
      justify-content: space-between;
      justify-self: stretch;
      white-space: normal;
    }

    .reader-nav-button {
      flex: 1 1 auto;
      justify-content: center;
    }

    .reader-page {
      min-height: auto;
      padding: 1.35rem;
    }

    .reader-page :global(h2) {
      max-width: 100%;
    }
  }
</style>
