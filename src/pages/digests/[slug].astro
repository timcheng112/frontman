---
import { render } from "astro:content";
import DigestReader from "../../components/DigestReader.astro";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getDigestCollection } from "../../utils/content";

export async function getStaticPaths() {
  const digests = await getDigestCollection();

  return digests.map((digest) => ({
    params: { slug: digest.id },
    props: { digest }
  }));
}

const { digest } = Astro.props;
const { Content, headings } = await render(digest);
---

<ArticleLayout
  title={`${digest.data.title} | Frontman`}
  description={digest.data.description}
  stickyTitle={digest.data.title}
>
  <DigestReader digest={digest} headings={headings}>
    <Content />
  </DigestReader>
</ArticleLayout>
